# Copy to .env and fill in real values. Never commit .env.

# --- LLM provider (0.1.2, 0.4.2) ---
# Planner model. Keep the model ID exact; no date suffix.
ANTHROPIC_API_KEY=sk-ant-replace-me
LLM_MODEL=claude-sonnet-5

# --- Verifier (1.5.3, 1.5.10) ---
# A cheaper model than the planner, run at temperature 0.
VERIFIER_MODEL=claude-haiku-4-5
MAX_REVISIONS=2

# --- Agent loop (0.4.2) ---
MAX_AGENT_LOOPS=6

# --- Qdrant (1.1.2, 1.2.12) ---
QDRANT_URL=http://localhost:6333
COLLECTION_NAME=sec_filings

# --- Embeddings (1.2.12) ---
# FastEmbed default; truncates at 512 tokens, so chunk size must match.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Redis Stack checkpointer (1.1.3, 1.3.16) ---
# Needs Redis Stack (RedisJSON + RediSearch), not plain Redis.
REDIS_URL=redis://localhost:6379

# --- SEC / EdgarTools (1.2.1) ---
# The SEC requires a contact identity on every request.
SEC_IDENTITY="Your Name your.email@example.com"

# --- Mock portfolio database (2.2.1) ---
DATABASE_URL=sqlite+aiosqlite:///./data/finai.db

# --- API auth (2.1.9) ---
# X-API-Key header value mapped to a user_id. Never read user_id from the body.
API_KEY=dev-local-key-replace-me

# --- Tracing (1.4.2) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2-replace-me
LANGSMITH_PROJECT=finai-agent-dev
