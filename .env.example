# Copy to .env and fill in real values. Never commit .env.

# --- LLM provider (0.1.2, 0.4.2) ---
# Planner model. Keep the model ID exact; no date suffix.
ANTHROPIC_API_KEY=sk-ant-replace-me
LLM_MODEL=claude-sonnet-5-5
# claude-haiku-5-5 is 20x cheaper for development; evaluate with the deployed model.
LLM_EFFORT=medium
LLM_MAX_TOKENS=16000
# Server-side refusal fallback (Claude API only; off on Bedrock/Vertex/Foundry).
LLM_REFUSAL_FALLBACK=true

# --- Verifier (1.5.3, 1.5.10) ---
# A cheaper model than the planner, run at temperature 0.
VERIFIER_MODEL=claude-haiku-5-5
MAX_REVISIONS=2

# --- Agent loop (0.4.2) ---
MAX_AGENT_LOOPS=6

# --- Qdrant (1.1.2, 1.2.12) ---
QDRANT_URL=http://localhost:6333
COLLECTION_NAME=sec_filings

# --- Embeddings (1.2.8) ---
# Voyage AI. Without a payment method the key is limited to 3 requests and
# 10K tokens per minute; free tokens still apply once one is added.
VOYAGE_API_KEY=pa-replace-me
EMBEDDING_MODEL=voyage-4
EMBEDDING_MAX_TOKENS=32000
# Qdrant collection vector size. Changing model or size means re-embedding.
EMBEDDING_DIM=1024
# Reranker over the top candidates of each search (docs/evals/retrieval-reranking.md).
RERANK_MODEL=rerank-2.5
RERANK_CANDIDATES=30
CHUNK_TOKENS=1000
CHUNK_OVERLAP_TOKENS=100

# --- Market data (1.3.1) ---
# Finnhub live quotes. The free plan covers US listings at 60 calls/min; a
# quote costs three calls. Price history is paid-only there (403), see 1.3.24.
FINNHUB_API_KEY=replace-me

# --- Redis checkpointer (1.1.3, 1.3.16) ---
# Needs JSON and Search. Both are in Redis 8 core; redis:7 has neither.
REDIS_URL=redis://localhost:6379

# --- SEC / EdgarTools (1.2.1) ---
# The SEC requires a contact identity on every request.
SEC_IDENTITY="Your Name your.email@example.com"

# Gzipped archive of fetched filings, for provenance (1.2.4).
RAW_FILINGS_DIR=data/raw
# edgartools local store: the cache that keeps re-runs off the SEC.
EDGAR_LOCAL_DATA_DIR=data/edgar
# SEC caps requests at 10/s. The limiter is per process, so parallel
# workers multiply this value rather than sharing it.
EDGAR_RATE_LIMIT_PER_SEC=5
# Set false to forbid SEC requests entirely and serve only from the store.
EDGAR_ALLOW_NETWORK_FALLBACK=true

# --- Mock portfolio database (2.2.1) ---
DATABASE_URL=sqlite+aiosqlite:///./data/finai.db

# --- API auth (2.1.9) ---
# X-API-Key header value mapped to a user_id. Never read user_id from the body.
API_KEY=dev-local-key-replace-me

# --- Tracing (1.4.2) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2-replace-me
LANGSMITH_PROJECT=finai-agent-dev
